# Names only — copy to .env.local. Never commit real secrets.
# Same Firebase project as Spycy/Ishaare (akxh-games).

# Canonical origin (server-only), e.g. https://shaanpatti.vercel.app or http://localhost:3000
SITE_URL=

# Firebase Admin — Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key from the JSON; keep \n escapes or paste PEM with real newlines
FIREBASE_PRIVATE_KEY=

# Firebase web config — Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public GA4 measurement id. Required for game events.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Shaanpatti /admin pack editor (server-only — never NEXT_PUBLIC_)
ADMIN_PASSWORD=
