rules_version = '2';
// Shared Firebase project (akxh-games).
// Shaanpatti / Who zzit? use NO Firebase Auth — local UUID identity only.
// Deploy as the full ruleset (merge). Do not deploy a single-game subset.
service cloud.firestore {
  match /databases/{database}/documents {
    // —— Shaanpatti (open lobby sync; no request.auth) ——
    match /shaanpatti_lobbies/{lobbyId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /shaanpatti_users/{userId} {
      allow read, write: if true;
    }
    match /shaanpatti_words/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /shaanpatti_packs/{id} {
      allow read: if true;
      allow write: if false;
    }

    // —— Who zzit? ——
    match /whozzit_lobbies/{lobbyId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /whozzit_users/{userId} {
      allow read, write: if true;
    }
    match /whozzit_words/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /whozzit_packs/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /spycy_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /spycy_lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /spycy_words/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /ishaare_users/{uid} { allow read, write: if false; }
    match /ishaare_decks/{id} { allow read, write: if false; }
    match /ishaare_words/{id} { allow read, write: if false; }

    match /users/{id} { allow read, write: if false; }
    match /decks/{id} { allow read, write: if false; }
    match /words/{id} { allow read, write: if false; }
    match /lobbies/{id} { allow read, write: if false; }
  }
}
